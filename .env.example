# Copie este arquivo para .env e preencha os valores
# O arquivo .env NÃO deve ser commitado no repositório

# Remetente do e-mail de alerta (ex: seu-email@gmail.com)
EMAIL_SENDER=

# Senha de aplicativo (Gmail: https://myaccount.google.com/apppasswords)
EMAIL_PASSWORD=

# Configurações SMTP (padrão: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
